// Banco do Ecobeast: o único arquivo que descreve as tabelas
// (.specs/backend-api/architecture.md, "Banco"). Toda mudança começa aqui e
// vira uma migration (npm run db:migrate). Nada de criar ou alterar tabela
// pelo painel do Supabase.
//
// Convenções:
// - Tudo no schema Postgres "ecobeasts" (a API automática do Supabase só
//   publica o "public").
// - No banco, os nomes de .specs/game-data/architecture.md: tabelas no plural
//   e colunas em snake_case. Aqui, modelo em PascalCase e campo em camelCase;
//   a conversão de nome é sempre mecânica (growth_rate_id → growthRateId).
// - Campos escalares na mesma ordem das colunas dos JSON do catálogo.
// - Faixas de valor são CHECK escritos à mão no SQL da migration (o Prisma não
//   os descreve); cada campo com faixa tem o comentário "CHECK".

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ecobeasts"]
}

model Element {
  id       Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug     String  @unique
  name     String
  /// CHECK ^#[0-9A-Fa-f]{6}$ (migration init)
  colorHex String  @map("color_hex")
  isRare   Boolean @map("is_rare")

  attacking        ElementEfficacy[]         @relation("EfficacyAttacker")
  defending        ElementEfficacy[]         @relation("EfficacyDefender")
  statusImmunities StatusConditionImmunity[]
  species          SpeciesElement[]
  skills           Skill[]

  @@map("elements")
  @@schema("ecobeasts")
}

model ElementEfficacy {
  attackerElementId Int   @map("attacker_element_id")
  defenderElementId Int   @map("defender_element_id")
  /// CHECK IN (0, 0.5, 2) (migration init)
  multiplier        Float

  attacker Element @relation("EfficacyAttacker", fields: [attackerElementId], references: [id], onDelete: Restrict)
  defender Element @relation("EfficacyDefender", fields: [defenderElementId], references: [id], onDelete: Restrict)

  @@id([attackerElementId, defenderElementId])
  @@index([defenderElementId])
  @@map("element_efficacy")
  @@schema("ecobeasts")
}

model Stat {
  id           Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug         String  @unique
  name         String
  shortName    String  @map("short_name")
  isBattleOnly Boolean @map("is_battle_only")

  temperamentsIncreased Temperament[]          @relation("TemperamentIncreased")
  temperamentsDecreased Temperament[]          @relation("TemperamentDecreased")
  species               SpeciesStat[]
  skillEffects          SkillEffect[]
  creatureStats         CreatureInstanceStat[]

  @@map("stats")
  @@schema("ecobeasts")
}

model GrowthRate {
  id           Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug         String @unique
  name         String
  /// CHECK 0.1–10 (migration init)
  xpMultiplier Float  @map("xp_multiplier")

  species Species[]

  @@map("growth_rates")
  @@schema("ecobeasts")
}

model Rarity {
  id        Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug      String @unique
  name      String
  sortOrder Int    @unique @map("sort_order")

  species Species[]

  @@map("rarities")
  @@schema("ecobeasts")
}

/// Os 7 biomas de encontro. O slug é usado no código e não muda.
model Biome {
  id          Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration biomes)
  slug        String @unique
  name        String
  description String

  species     SpeciesBiome[]
  islandTiles IslandTile[]

  @@map("biomes")
  @@schema("ecobeasts")
}

model NpcTamerName {
  id   Int    @id @default(autoincrement())
  /// CHECK 1–20 caracteres (migration npc_tamer_texts)
  name String

  @@map("npc_tamer_names")
  @@schema("ecobeasts")
}

model ActionType {
  id       Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration islands)
  slug     String @unique
  name     String
  /// A cor dos hexágonos dela no editor. CHECK ^#[0-9A-Fa-f]{6}$ (migration islands)
  colorHex String @map("color_hex")
  /// O que a ação faz. CHECK open_screen (migration island_villages)
  kind     String

  actions IslandAction[]

  @@map("action_types")
  @@schema("ecobeasts")
}

model GroundType {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration island_villages)
  slug String @unique
  name String
  /// CHECK trail ou floor (migration island_villages)
  kind String

  tiles IslandTile[]

  @@map("ground_types")
  @@schema("ecobeasts")
}

model MapObjectType {
  id       Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration island_villages)
  slug     String @unique
  name     String
  /// Quantas variantes a arte tem. CHECK >= 1 (migration island_villages)
  variants Int

  tiles   MapObjectTypeTile[]
  objects IslandObject[]

  @@map("map_object_types")
  @@schema("ecobeasts")
}

model MapObjectTypeTile {
  objectTypeId Int     @map("object_type_id")
  dq           Int
  dr           Int
  blocks       Boolean

  objectType MapObjectType @relation(fields: [objectTypeId], references: [id], onDelete: Cascade)

  @@id([objectTypeId, dq, dr])
  @@map("map_object_type_tiles")
  @@schema("ecobeasts")
}

model NpcTamerGreeting {
  id   Int    @id @default(autoincrement())
  /// CHECK 1–120 caracteres (migration npc_tamer_texts)
  text String

  @@map("npc_tamer_greetings")
  @@schema("ecobeasts")
}

model Temperament {
  id              Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug            String @unique
  name            String
  increasedStatId Int    @map("increased_stat_id")
  decreasedStatId Int    @map("decreased_stat_id")

  increasedStat Stat               @relation("TemperamentIncreased", fields: [increasedStatId], references: [id], onDelete: Restrict)
  decreasedStat Stat               @relation("TemperamentDecreased", fields: [decreasedStatId], references: [id], onDelete: Restrict)
  creatures     CreatureInstance[]

  @@index([increasedStatId])
  @@index([decreasedStatId])
  @@map("temperaments")
  @@schema("ecobeasts")
}

model SkillCategory {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  skills Skill[]

  @@map("skill_categories")
  @@schema("ecobeasts")
}

model SkillTarget {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  skills       Skill[]
  skillEffects SkillEffect[]

  @@map("skill_targets")
  @@schema("ecobeasts")
}

model AreaShape {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration board_skill_areas)
  slug String @unique
  name String

  skills Skill[]

  @@map("area_shapes")
  @@schema("ecobeasts")
}

model SkillLearnMethod {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  speciesSkills SpeciesSkill[]

  @@map("skill_learn_methods")
  @@schema("ecobeasts")
}

model StatusCondition {
  id         Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug       String  @unique
  name       String
  isVolatile Boolean @map("is_volatile")

  immunities    StatusConditionImmunity[]
  skillEffects  SkillEffect[]
  creatures     CreatureInstance[]
  groundEffects GroundEffect[]

  @@map("status_conditions")
  @@schema("ecobeasts")
}

model GroundEffect {
  id                Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration board_skill_areas)
  slug              String @unique
  name              String
  /// CHECK 1–100, % do HP máximo (migration board_skill_areas)
  damagePercent     Int?   @map("damage_percent")
  statusConditionId Int?   @map("status_condition_id")
  /// CHECK ^#[0-9A-Fa-f]{6}$ (migration board_skill_areas)
  colorHex          String @map("color_hex")

  statusCondition StatusCondition? @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  skills          Skill[]

  @@index([statusConditionId])
  @@map("ground_effects")
  @@schema("ecobeasts")
}

model StatusConditionImmunity {
  statusConditionId Int @map("status_condition_id")
  elementId         Int @map("element_id")

  statusCondition StatusCondition @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  element         Element         @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@id([statusConditionId, elementId])
  @@index([elementId])
  @@map("status_condition_immunities")
  @@schema("ecobeasts")
}

model EffectType {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  skillEffects SkillEffect[]

  @@map("effect_types")
  @@schema("ecobeasts")
}

model EvolutionTrigger {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  evolutions Evolution[]

  @@map("evolution_triggers")
  @@schema("ecobeasts")
}

model Species {
  id                   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug                 String @unique
  name                 String
  description          String
  growthRateId         Int    @map("growth_rate_id")
  rarityId             Int    @map("rarity_id")
  /// CHECK ≥ 1 (migration init)
  baseXpYield          Int    @map("base_xp_yield")
  /// CHECK 0–100 (migration capture_rate_0_100)
  captureRate          Int    @map("capture_rate")
  /// CHECK −1–1; −1 = sem gênero (migration init)
  genderRatio          Float  @map("gender_ratio")
  /// CHECK ≥ 0 (migration init)
  heightM              Float  @map("height_m")
  /// CHECK ≥ 0 (migration init)
  weightKg             Float  @map("weight_kg")
  evolvesFromSpeciesId Int?   @map("evolves_from_species_id")

  growthRate     GrowthRate          @relation(fields: [growthRateId], references: [id], onDelete: Restrict)
  rarity         Rarity              @relation(fields: [rarityId], references: [id], onDelete: Restrict)
  evolvesFrom    Species?            @relation("SpeciesEvolvesFrom", fields: [evolvesFromSpeciesId], references: [id], onDelete: Restrict)
  evolvesTo      Species[]           @relation("SpeciesEvolvesFrom")
  elements       SpeciesElement[]
  stats          SpeciesStat[]
  traits         SpeciesTrait[]
  skills         SpeciesSkill[]
  evolutionsFrom Evolution[]         @relation("EvolutionFrom")
  evolutionsTo   Evolution[]         @relation("EvolutionTo")
  starterOption  StarterOption?
  creatures      CreatureInstance[]
  biomes         SpeciesBiome[]
  codexEntries   CodexEntry[]
  islandAreas    IslandAreaSpecies[]

  @@index([growthRateId])
  @@index([rarityId])
  @@index([evolvesFromSpeciesId])
  @@map("species")
  @@schema("ecobeasts")
}

model SpeciesElement {
  speciesId Int @map("species_id")
  /// CHECK IN (1, 2) (migration init)
  slot      Int
  elementId Int @map("element_id")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  element Element @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([elementId])
  @@map("species_elements")
  @@schema("ecobeasts")
}

model SpeciesBiome {
  speciesId Int @map("species_id")
  biomeId   Int @map("biome_id")
  /// CHECK 0–100 (migration biomes)
  rate      Int

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  biome   Biome   @relation(fields: [biomeId], references: [id], onDelete: Restrict)

  @@id([speciesId, biomeId])
  @@index([biomeId])
  @@map("species_biomes")
  @@schema("ecobeasts")
}

model SpeciesStat {
  speciesId     Int @map("species_id")
  statId        Int @map("stat_id")
  /// CHECK 1–255 (migration init)
  baseValue     Int @map("base_value")
  /// CHECK 0–3 (migration init)
  trainingYield Int @map("training_yield")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  stat    Stat    @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@id([speciesId, statId])
  @@index([statId])
  @@map("species_stats")
  @@schema("ecobeasts")
}

model Trait {
  id          Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug        String @unique
  name        String
  description String

  species   SpeciesTrait[]
  creatures CreatureInstance[]

  @@map("traits")
  @@schema("ecobeasts")
}

model SpeciesTrait {
  speciesId Int     @map("species_id")
  traitId   Int     @map("trait_id")
  /// CHECK IN (1, 2, 3) (migration init)
  slot      Int
  isHidden  Boolean @map("is_hidden")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  trait   Trait   @relation(fields: [traitId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([traitId])
  @@map("species_traits")
  @@schema("ecobeasts")
}

model Evolution {
  id                 Int     @id @default(autoincrement())
  speciesId          Int     @map("species_id")
  evolvedSpeciesId   Int     @map("evolved_species_id")
  evolutionTriggerId Int     @map("evolution_trigger_id")
  /// CHECK 1–100 (migration init)
  minLevel           Int?    @map("min_level")
  /// FK futura: items. CHECK IS NULL até a tabela existir (migration init)
  itemId             Int?    @map("item_id")
  /// CHECK 0–255 (migration init)
  minBond            Int?    @map("min_bond")
  /// CHECK IN ('day', 'night') (migration init)
  timeOfDay          String? @map("time_of_day")
  /// FK futura: zones. CHECK IS NULL até a tabela existir (migration init)
  zoneId             Int?    @map("zone_id")

  species          Species          @relation("EvolutionFrom", fields: [speciesId], references: [id], onDelete: Restrict)
  evolvedSpecies   Species          @relation("EvolutionTo", fields: [evolvedSpeciesId], references: [id], onDelete: Restrict)
  evolutionTrigger EvolutionTrigger @relation(fields: [evolutionTriggerId], references: [id], onDelete: Restrict)

  @@index([speciesId])
  @@index([evolvedSpeciesId])
  @@index([evolutionTriggerId])
  @@map("evolutions")
  @@schema("ecobeasts")
}

model StarterOption {
  speciesId Int @id @map("species_id")
  sortOrder Int @unique @map("sort_order")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@map("starter_options")
  @@schema("ecobeasts")
}

model Skill {
  id              Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug            String  @unique
  name            String
  description     String
  elementId       Int     @map("element_id")
  skillCategoryId Int     @map("skill_category_id")
  /// CHECK 0–250 (migration init)
  power           Int
  /// CHECK 0–100 (migration init)
  accuracy        Int
  /// CHECK 5–40 (migration init)
  maxPp           Int     @map("max_pp")
  /// CHECK −7–5 (migration init)
  priority        Int
  /// CHECK 0–3 (migration init)
  critStage       Int     @map("crit_stage")
  skillTargetId   Int     @map("skill_target_id")
  makesContact    Boolean @map("makes_contact")
  /// CHECK 1–10 (migration init)
  minHits         Int     @map("min_hits")
  /// CHECK 1–10 (migration init)
  maxHits         Int     @map("max_hits")
  areaShapeId     Int     @default(1) @map("area_shape_id")
  /// CHECK 1–6 (migration board_skill_areas)
  range           Int     @default(1)
  pierces         Boolean @default(false)
  groundEffectId  Int?    @map("ground_effect_id")
  /// CHECK 1–20, e nulo junto com ground_effect_id (migration board_skill_areas)
  groundTurns     Int?    @map("ground_turns")

  element        Element                 @relation(fields: [elementId], references: [id], onDelete: Restrict)
  skillCategory  SkillCategory           @relation(fields: [skillCategoryId], references: [id], onDelete: Restrict)
  skillTarget    SkillTarget             @relation(fields: [skillTargetId], references: [id], onDelete: Restrict)
  areaShape      AreaShape               @relation(fields: [areaShapeId], references: [id], onDelete: Restrict)
  groundEffect   GroundEffect?           @relation(fields: [groundEffectId], references: [id], onDelete: Restrict)
  effects        SkillEffect[]
  learnedBy      SpeciesSkill[]
  creatureSkills CreatureInstanceSkill[]

  @@index([elementId])
  @@index([skillCategoryId])
  @@index([skillTargetId])
  @@index([areaShapeId])
  @@index([groundEffectId])
  @@map("skills")
  @@schema("ecobeasts")
}

model SkillEffect {
  id                Int  @id @default(autoincrement())
  skillId           Int  @map("skill_id")
  effectTypeId      Int  @map("effect_type_id")
  /// CHECK ≥ 1 (migration init)
  sortOrder         Int  @map("sort_order")
  /// CHECK 1–100 (migration init)
  chance            Int
  skillTargetId     Int? @map("skill_target_id")
  statusConditionId Int? @map("status_condition_id")
  statId            Int? @map("stat_id")
  /// CHECK −6–6 (migration init)
  stages            Int?
  /// CHECK 1–100 (migration init)
  percent           Int?
  /// CHECK ≥ 1 (migration init)
  value             Int?
  /// FK futura: weathers. CHECK IS NULL até a tabela existir (migration init)
  weatherId         Int? @map("weather_id")
  /// CHECK ≥ 1 (migration init)
  minTurns          Int? @map("min_turns")

  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  effectType      EffectType       @relation(fields: [effectTypeId], references: [id], onDelete: Restrict)
  skillTarget     SkillTarget?     @relation(fields: [skillTargetId], references: [id], onDelete: Restrict)
  statusCondition StatusCondition? @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  stat            Stat?            @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@unique([skillId, sortOrder])
  @@index([effectTypeId])
  @@index([skillTargetId])
  @@index([statusConditionId])
  @@index([statId])
  @@map("skill_effects")
  @@schema("ecobeasts")
}

model SpeciesSkill {
  speciesId          Int  @map("species_id")
  skillId            Int  @map("skill_id")
  skillLearnMethodId Int  @map("skill_learn_method_id")
  /// CHECK 0–100 (migration init)
  level              Int?

  species          Species          @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  skillLearnMethod SkillLearnMethod @relation(fields: [skillLearnMethodId], references: [id], onDelete: Restrict)

  @@id([speciesId, skillId, skillLearnMethodId])
  @@index([skillId])
  @@index([skillLearnMethodId])
  @@map("species_skills")
  @@schema("ecobeasts")
}

model ItemCategory {
  id        Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration items)
  slug      String @unique
  name      String
  sortOrder Int    @unique @map("sort_order")

  items Item[]

  @@map("item_categories")
  @@schema("ecobeasts")
}

model Item {
  id             Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration items)
  slug           String  @unique
  name           String
  description    String
  itemCategoryId Int     @map("item_category_id")
  /// CHECK ≥ 1 (migration items)
  price          Int
  sortOrder      Int     @unique @map("sort_order")
  /// CHECK > 0 (migration items)
  captureBonus   Float?  @map("capture_bonus")
  /// CHECK ≥ 1 (migration items)
  healAmount     Int?    @map("heal_amount")
  curesStatus    Boolean @default(false) @map("cures_status")

  itemCategory ItemCategory    @relation(fields: [itemCategoryId], references: [id], onDelete: Restrict)
  inventory    InventoryItem[]

  @@index([itemCategoryId])
  @@map("items")
  @@schema("ecobeasts")
}

enum Gender {
  male
  female
  none

  @@map("gender")
  @@schema("ecobeasts")
}

enum CreatureLocation {
  party
  storage

  @@map("creature_location")
  @@schema("ecobeasts")
}

model Player {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// CHECK 1–100 (migration init)
  level     Int      @default(1)
  /// CHECK ≥ 0 (migration init)
  coins     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  creatures CreatureInstance[]
  inventory InventoryItem[]
  codex     CodexEntry[]

  @@map("players")
  @@schema("ecobeasts")
}

model CreatureInstance {
  uid               String           @id @default(uuid()) @db.Uuid
  playerId          String           @map("player_id") @db.Uuid
  speciesId         Int              @map("species_id")
  nickname          String?
  /// CHECK 1–100 (migration init)
  level             Int
  /// CHECK ≥ 0 (migration init)
  currentXp         Int              @map("current_xp")
  /// CHECK ≥ 0 (migration init)
  currentHp         Int              @map("current_hp")
  temperamentId     Int              @map("temperament_id")
  traitId           Int              @map("trait_id")
  gender            Gender
  isPrismatic       Boolean          @default(false) @map("is_prismatic")
  /// CHECK 0–255 (migration init)
  bond              Int
  /// FK futura: items. CHECK IS NULL até a tabela existir (migration init)
  heldItemId        Int?             @map("held_item_id")
  statusConditionId Int?             @map("status_condition_id")
  /// CHECK party ⇔ party_slot preenchido (migration init)
  location          CreatureLocation
  /// CHECK 1–6 (migration init)
  partySlot         Int?             @map("party_slot")
  /// Domador original; sem relação, porque ele pode não existir mais.
  originalPlayerId  String           @map("original_player_id") @db.Uuid
  caughtAt          DateTime         @map("caught_at") @db.Timestamptz(3)
  /// FK futura: zones. CHECK IS NULL até a tabela existir (migration init)
  caughtZoneId      Int?             @map("caught_zone_id")

  player          Player                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  species         Species                 @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  temperament     Temperament             @relation(fields: [temperamentId], references: [id], onDelete: Restrict)
  trait           Trait                   @relation(fields: [traitId], references: [id], onDelete: Restrict)
  statusCondition StatusCondition?        @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  stats           CreatureInstanceStat[]
  skills          CreatureInstanceSkill[]

  @@unique([playerId, partySlot])
  @@index([speciesId])
  @@index([temperamentId])
  @@index([traitId])
  @@index([statusConditionId])
  @@map("creature_instances")
  @@schema("ecobeasts")
}

model CreatureInstanceStat {
  creatureUid    String @map("creature_uid") @db.Uuid
  statId         Int    @map("stat_id")
  /// CHECK 0–31 (migration init)
  genes          Int
  /// CHECK 0–252 (migration init)
  trainingPoints Int    @map("training_points")

  creature CreatureInstance @relation(fields: [creatureUid], references: [uid], onDelete: Cascade)
  stat     Stat             @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@id([creatureUid, statId])
  @@index([statId])
  @@map("creature_instance_stats")
  @@schema("ecobeasts")
}

model CreatureInstanceSkill {
  creatureUid String @map("creature_uid") @db.Uuid
  /// CHECK 1–4 (migration init)
  slot        Int
  skillId     Int    @map("skill_id")
  /// CHECK ≥ 0 (migration init)
  currentPp   Int    @map("current_pp")

  creature CreatureInstance @relation(fields: [creatureUid], references: [uid], onDelete: Cascade)
  skill    Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([creatureUid, slot])
  @@index([skillId])
  @@map("creature_instance_skills")
  @@schema("ecobeasts")
}

model InventoryItem {
  playerId String @map("player_id") @db.Uuid
  itemId   Int    @map("item_id")
  /// CHECK ≥ 1 (migration init)
  quantity Int

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([playerId, itemId])
  @@index([itemId])
  @@map("inventory_items")
  @@schema("ecobeasts")
}

model CodexEntry {
  playerId  String    @map("player_id") @db.Uuid
  speciesId Int       @map("species_id")
  seenAt    DateTime  @map("seen_at") @db.Timestamptz(3)
  /// Nulo enquanto só foi visto. CHECK ≥ seen_at (migration codex_entries)
  caughtAt  DateTime? @map("caught_at") @db.Timestamptz(3)

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@id([playerId, speciesId])
  @@index([speciesId])
  @@map("codex_entries")
  @@schema("ecobeasts")
}

model Island {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  maps IslandMap[]

  @@map("islands")
  @@schema("ecobeasts")
}

model IslandMap {
  id          Int      @id @default(autoincrement())
  islandId    Int      @map("island_id")
  /// CHECK draft ou published (migration islands)
  kind        String
  /// CHECK 1–40 caracteres (migration islands)
  name        String
  startQ      Int      @map("start_q")
  startR      Int      @map("start_r")
  contentHash String   @map("content_hash")
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  island      Island             @relation(fields: [islandId], references: [id], onDelete: Cascade)
  tiles       IslandTile[]
  actions     IslandAction[]
  actionTiles IslandActionTile[]
  objects     IslandObject[]
  objectTiles IslandObjectTile[]
  areas       IslandArea[]

  @@unique([islandId, kind])
  @@map("island_maps")
  @@schema("ecobeasts")
}

model IslandTile {
  islandMapId  Int  @map("island_map_id")
  q            Int
  r            Int
  /// Um dos 7 biomas; a variante de 1 a 3 em hill e mountain é conferida pela rota.
  biomeId      Int  @map("biome_id")
  /// CHECK 0–10 (migration terrain_height_ten)
  height       Int
  /// CHECK 1–6 (migration terrain_height)
  variant      Int
  areaId       Int? @map("area_id")
  groundTypeId Int? @map("ground_type_id")

  islandMap  IslandMap   @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  biome      Biome       @relation(fields: [biomeId], references: [id], onDelete: Restrict)
  area       IslandArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  groundType GroundType? @relation(fields: [groundTypeId], references: [id], onDelete: Restrict)

  @@id([islandMapId, q, r])
  @@index([biomeId])
  @@index([areaId])
  @@index([groundTypeId])
  @@map("island_tiles")
  @@schema("ecobeasts")
}

model IslandAction {
  id           Int @id @default(autoincrement())
  islandMapId  Int @map("island_map_id")
  actionTypeId Int @map("action_type_id")

  islandMap  IslandMap          @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  actionType ActionType         @relation(fields: [actionTypeId], references: [id], onDelete: Restrict)
  tiles      IslandActionTile[]

  @@index([islandMapId])
  @@index([actionTypeId])
  @@map("island_actions")
  @@schema("ecobeasts")
}

/// Um hexágono de uma ação; duas ações nunca dividem um hexágono.
model IslandActionTile {
  actionId    Int @map("action_id")
  islandMapId Int @map("island_map_id")
  q           Int
  r           Int

  action    IslandAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  islandMap IslandMap    @relation(fields: [islandMapId], references: [id], onDelete: Cascade)

  @@id([actionId, q, r])
  @@unique([islandMapId, q, r])
  @@map("island_action_tiles")
  @@schema("ecobeasts")
}

model IslandObject {
  id           Int     @id @default(autoincrement())
  islandMapId  Int     @map("island_map_id")
  objectTypeId Int     @map("object_type_id")
  q            Int
  r            Int
  /// CHECK >= 1 (migration island_villages)
  variant      Int
  mirrored     Boolean

  islandMap  IslandMap          @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  objectType MapObjectType      @relation(fields: [objectTypeId], references: [id], onDelete: Restrict)
  tiles      IslandObjectTile[]

  @@index([islandMapId])
  @@index([objectTypeId])
  @@map("island_objects")
  @@schema("ecobeasts")
}

/// Um hexágono de um objeto, com o bloqueio; dois objetos nunca dividem um hexágono.
model IslandObjectTile {
  objectId    Int     @map("object_id")
  islandMapId Int     @map("island_map_id")
  q           Int
  r           Int
  blocks      Boolean

  object    IslandObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  islandMap IslandMap    @relation(fields: [islandMapId], references: [id], onDelete: Cascade)

  @@id([objectId, q, r])
  @@unique([islandMapId, q, r])
  @@map("island_object_tiles")
  @@schema("ecobeasts")
}

model IslandArea {
  id          Int    @id @default(autoincrement())
  islandMapId Int    @map("island_map_id")
  /// CHECK 1–40 caracteres (migration islands)
  name        String
  /// Só para o editor. CHECK ^#[0-9A-Fa-f]{6}$ (migration islands)
  colorHex    String @map("color_hex")
  /// Quantos Ecobeasts nascem nela a cada entrada. CHECK 1–200 (migration island_area_spawn_count)
  spawnCount  Int    @default(10) @map("spawn_count")

  islandMap IslandMap           @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  species   IslandAreaSpecies[]
  tiles     IslandTile[]

  @@index([islandMapId])
  @@map("island_areas")
  @@schema("ecobeasts")
}

model IslandAreaSpecies {
  areaId    Int @map("area_id")
  speciesId Int @map("species_id")
  /// CHECK > 0 (migration islands)
  weight    Int
  /// CHECK 1–100 e ≤ max_level (migration islands)
  minLevel  Int @map("min_level")
  /// CHECK 1–100 (migration islands)
  maxLevel  Int @map("max_level")

  area    IslandArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  species Species    @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@id([areaId, speciesId])
  @@index([speciesId])
  @@map("island_area_species")
  @@schema("ecobeasts")
}

enum LoginStatus {
  pending
  complete
  failed

  @@map("login_status")
  @@schema("ecobeasts")
}

model AuthLoginSession {
  id             String      @id @default(uuid()) @db.Uuid
  pollSecretHash String      @map("poll_secret_hash")
  codeVerifier   String      @map("code_verifier")
  status         LoginStatus @default(pending)
  opened         Boolean     @default(false)
  accessToken    String?     @map("access_token")
  refreshToken   String?     @map("refresh_token")
  expiresIn      Int?        @map("expires_in")
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_login_sessions")
  @@schema("ecobeasts")
}
