// Banco do Ecobeast: o único arquivo que descreve as tabelas
// (.specs/backend-api/architecture.md, "Banco"). Toda mudança começa aqui e
// vira uma migration (npm run db:migrate). Nada de criar ou alterar tabela
// pelo painel do Supabase.
//
// Convenções:
// - Tudo no schema Postgres "ecobeasts" (a API automática do Supabase só
//   publica o "public").
// - No banco, os nomes de .specs/game-data/architecture.md: tabelas no plural
//   e colunas em snake_case. Aqui, modelo em PascalCase e campo em camelCase;
//   a conversão de nome é sempre mecânica (growth_rate_id → growthRateId).
// - Campos escalares na mesma ordem das colunas dos JSON do catálogo.
// - Faixas de valor são CHECK escritos à mão no SQL da migration (o Prisma não
//   os descreve); cada campo com faixa tem o comentário "CHECK".

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ecobeasts"]
}

model Element {
  id       Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug     String  @unique
  name     String
  /// CHECK ^#[0-9A-Fa-f]{6}$ (migration init)
  colorHex String  @map("color_hex")
  isRare   Boolean @map("is_rare")

  attacking        ElementEfficacy[]         @relation("EfficacyAttacker")
  defending        ElementEfficacy[]         @relation("EfficacyDefender")
  statusImmunities StatusConditionImmunity[]
  species          SpeciesElement[]
  skills           Skill[]

  @@map("elements")
  @@schema("ecobeasts")
}

model ElementEfficacy {
  attackerElementId Int   @map("attacker_element_id")
  defenderElementId Int   @map("defender_element_id")
  /// CHECK IN (0, 0.5, 2) (migration init)
  multiplier        Float

  attacker Element @relation("EfficacyAttacker", fields: [attackerElementId], references: [id], onDelete: Restrict)
  defender Element @relation("EfficacyDefender", fields: [defenderElementId], references: [id], onDelete: Restrict)

  @@id([attackerElementId, defenderElementId])
  @@index([defenderElementId])
  @@map("element_efficacy")
  @@schema("ecobeasts")
}

model Stat {
  id           Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug         String  @unique
  name         String
  shortName    String  @map("short_name")
  isBattleOnly Boolean @map("is_battle_only")

  temperamentsIncreased Temperament[]          @relation("TemperamentIncreased")
  temperamentsDecreased Temperament[]          @relation("TemperamentDecreased")
  species               SpeciesStat[]
  skillEffects          SkillEffect[]
  creatureStats         CreatureInstanceStat[]
  groundEffectStats     GroundEffectStat[]

  @@map("stats")
  @@schema("ecobeasts")
}

model GrowthRate {
  id           Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug         String @unique
  name         String
  /// CHECK 0.1–10 (migration init)
  xpMultiplier Float  @map("xp_multiplier")

  species Species[]

  @@map("growth_rates")
  @@schema("ecobeasts")
}

model Rarity {
  id        Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug      String @unique
  name      String
  sortOrder Int    @unique @map("sort_order")

  species Species[]

  @@map("rarities")
  @@schema("ecobeasts")
}

/// Os 7 biomas de encontro. O slug é usado no código e não muda.
model Biome {
  id          Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration biomes)
  slug        String @unique
  name        String
  description String

  species     SpeciesBiome[]
  islandTiles IslandTile[]
  zones       BiomeZone[]

  @@map("biomes")
  @@schema("ecobeasts")
}

/// As zonas de cada bioma (.specs/biome-zones/01-zone-records.md). A Comum tem o slug do bioma.
model BiomeZone {
  id        Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration biome_zones)
  slug      String @unique
  biomeId   Int    @map("biome_id")
  /// CHECK 1–40 caracteres (migration biome_zones)
  name      String
  /// A parte do bioma no mapa sorteado, dividida pela soma das zonas dele. CHECK 0–100 (migration biome_zones)
  share     Int
  sortOrder Int    @map("sort_order")

  biome       Biome              @relation(fields: [biomeId], references: [id], onDelete: Restrict)
  species     SpeciesBiomeZone[]
  islandTiles IslandTile[]

  @@index([biomeId])
  @@map("biome_zones")
  @@schema("ecobeasts")
}

/// As partes do dia do relógio do mundo (.specs/day-night/01-world-clock.md).
model DayPhase {
  id          Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration day_phases)
  slug        String @unique
  name        String
  /// O minuto do dia em que a parte começa. CHECK 0 a 1439 (migration day_phases)
  startMinute Int    @unique @map("start_minute")

  species SpeciesDayPhase[]

  @@map("day_phases")
  @@schema("ecobeasts")
}

/// Os números do Domador no Perfil (player-stats/01).
model Counter {
  id      Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration counters)
  slug    String @unique
  name    String
  /// O que o subject_id das linhas do jogador quer dizer.
  /// CHECK none, element, day_phase ou biome (migration counters)
  subject String

  players PlayerCounter[]

  @@map("counters")
  @@schema("ecobeasts")
}

model NpcTamerName {
  id   Int    @id @default(autoincrement())
  /// CHECK 1–20 caracteres (migration npc_tamer_texts)
  name String

  @@map("npc_tamer_names")
  @@schema("ecobeasts")
}

model ActionType {
  id       Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration islands)
  slug     String @unique
  name     String
  /// A cor dos hexágonos dela no editor. CHECK ^#[0-9A-Fa-f]{6}$ (migration islands)
  colorHex String @map("color_hex")
  /// O que a ação faz. CHECK open_screen (migration island_villages)
  kind     String

  actions      IslandAction[]
  npcs         IslandNpc[]
  props        IslandProp[]
  interiorNpcs InteriorNpc[]

  @@map("action_types")
  @@schema("ecobeasts")
}

model GroundType {
  id       Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration island_villages)
  slug     String @unique
  name     String
  /// CHECK trail ou floor (migration island_villages)
  kind     String
  /// CHECK 1 a 3 (migration free_trails_ground_types)
  hardness Int    @db.SmallInt

  tiles  IslandTile[]
  trails IslandTrail[]

  @@map("ground_types")
  @@schema("ecobeasts")
}

/// A categoria de um tipo de peça na ferramenta Peças do editor (.specs/editor-ui).
model PropCategory {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration prop_categories)
  slug String @unique
  /// O que o editor mostra; a ordem é a do id.
  name String

  propTypes PropType[]

  @@map("prop_categories")
  @@schema("ecobeasts")
}

model PropType {
  id             Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration free_props)
  slug           String @unique
  name           String
  /// Quantas variantes a arte tem. CHECK >= 1 (migration free_props)
  variants       Int
  /// A categoria no editor; um tipo novo sem ela fica em Objetos (migration prop_categories)
  propCategoryId Int    @default(10) @map("prop_category_id")

  category PropCategory    @relation(fields: [propCategoryId], references: [id])
  props    IslandProp[]
  blocks   PropTypeBlock[]
  lights   PropTypeLight[]

  @@index([propCategoryId])
  @@map("prop_types")
  @@schema("ecobeasts")
}

/// Uma linha de bloqueio padrão de um tipo de peça (.specs/free-objects).
model PropTypeBlock {
  id         Int     @id @default(autoincrement())
  propTypeId Int     @map("prop_type_id")
  /// A variante a que a linha vale; 0 vale para todas as que não têm linhas próprias
  /// (prop-depth-blocks/02). CHECK 0 a 99 (migration variant_blocks)
  variant    Int     @default(0)
  /// A ordem no tipo, de 0 em diante.
  position   Int
  /// Liga o último ponto ao primeiro.
  closed     Boolean
  /// x0, y0, x1, y1, … em pixels da arte, a partir do pé da peça.
  /// CHECK tamanho par, de 4 a 128 (migration prop_blocks)
  points     Int[]

  propType PropType @relation(fields: [propTypeId], references: [id], onDelete: Cascade)

  @@unique([propTypeId, variant, position])
  @@map("prop_type_blocks")
  @@schema("ecobeasts")
}

/// Um ponto de luz da noite de um tipo de peça (.specs/day-night/03-night-lights.md).
model PropTypeLight {
  id         Int    @id @default(autoincrement())
  propTypeId Int    @map("prop_type_id")
  /// A variante a que a luz vale; 0 vale para todas as que não têm luzes próprias.
  /// CHECK 0 a 99 (migration prop_type_lights)
  variant    Int    @default(0)
  /// A ordem no tipo e na variante, de 0 em diante.
  position   Int
  /// O pixel do centro, a partir do pé da peça.
  x          Int
  y          Int
  /// Em pixels da arte. CHECK 2 a 96 (migration prop_type_lights)
  radius     Int
  /// CHECK ^[0-9a-f]{6}$ (migration prop_type_lights)
  color      String

  propType PropType @relation(fields: [propTypeId], references: [id], onDelete: Cascade)

  @@unique([propTypeId, variant, position])
  @@map("prop_type_lights")
  @@schema("ecobeasts")
}

model Voice {
  id             Int    @id @default(autoincrement())
  /// O arquivo assets/sounds/voices/<slug>.wav do jogo. CHECK ^[a-z0-9_]+$ (migration dialogue_voices)
  slug           String @unique
  /// O que o editor mostra.
  name           String
  /// Letras por segundo na caixa de fala. CHECK 20 a 90 (migration dialogue_voices)
  charsPerSecond Int    @map("chars_per_second")
  /// Um bipe a cada tantas letras. CHECK 1 a 4 (migration dialogue_voices)
  lettersPerBlip Int    @map("letters_per_blip")
  /// Quanto a altura varia, em %. CHECK 0 a 25 (migration dialogue_voices)
  pitchVariation Int    @map("pitch_variation")

  npcs Npc[]

  @@map("voices")
  @@schema("ecobeasts")
}

model Npc {
  id              Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration island_npcs)
  slug            String  @unique
  /// O que a caixa de fala mostra.
  name            String
  /// Só para o editor.
  description     String
  /// A pasta assets/creatures/<sprite>/ do jogo; nulo é NPC pessoa. CHECK ^[a-z0-9_]+$ (migration island_npcs)
  sprite          String?
  /// O corpo do NPC pessoa. CHECK sprite ou corpo, nunca os dois: npcs_look_check (migration person_npcs)
  bodyTypeId      Int?    @map("body_type_id")
  /// A pele do NPC pessoa, junto com o corpo (migration person_npcs)
  skinPaletteId   Int?    @map("skin_palette_id")
  /// A voz na caixa de fala; um NPC novo nasce com a Média (migration dialogue_voices)
  voiceId         Int     @default(4) @map("voice_id")
  /// A fala que o NPC ganha ao ser posto no F2. CHECK até 2.000 caracteres (migration village_crowd)
  defaultDialogue String  @default("") @map("default_dialogue")

  bodyType        BodyType?           @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  voice           Voice               @relation(fields: [voiceId], references: [id], onDelete: Restrict)
  skinPalette     Palette?            @relation(fields: [skinPaletteId], references: [id], onDelete: Restrict)
  islandNpcs      IslandNpc[]
  appearanceParts NpcAppearancePart[]
  interiorNpcs    InteriorNpc[]

  @@index([bodyTypeId])
  @@index([skinPaletteId])
  @@index([voiceId])
  @@map("npcs")
  @@schema("ecobeasts")
}

/// Os corpos do Domador (tamer-appearance/01).
model BodyType {
  id   Int    @id @default(autoincrement())
  /// A pasta assets/tamer/bodies/<slug>/ do jogo. CHECK ^[a-z0-9_]+$ (migration tamer_appearance)
  slug String @unique
  name String

  parts   AppearancePart[]
  players Player[]
  npcs    Npc[]

  @@map("body_types")
  @@schema("ecobeasts")
}

/// Os lugares do corpo, na ordem de desenho (tamer-appearance/01).
model AppearanceSlot {
  id          Int     @id @default(autoincrement())
  /// O jogo conhece hair e headwear. CHECK ^[a-z0-9_]+$ (migration tamer_appearance)
  slug        String  @unique
  name        String
  /// Ordem de desenho por cima do corpo. CHECK >= 1 (migration tamer_appearance)
  layer       Int     @unique
  /// O tipo de paleta que a peça aceita; nulo é cor fixa. CHECK skin, hair ou cloth (migration tamer_appearance)
  paletteKind String? @map("palette_kind")
  /// O jogador não pode ficar sem peça nesse lugar.
  required    Boolean

  parts       AppearancePart[]
  playerParts PlayerAppearancePart[]
  npcParts    NpcAppearancePart[]

  @@map("appearance_slots")
  @@schema("ecobeasts")
}

/// As peças da aparência (tamer-appearance/01).
model AppearancePart {
  id               Int    @id @default(autoincrement())
  /// A pasta assets/tamer/parts/<slug>/ do jogo. CHECK ^[a-z0-9_]+$ (migration tamer_appearance)
  slug             String @unique
  name             String
  appearanceSlotId Int    @map("appearance_slot_id")
  /// Nulo serve nos dois corpos.
  bodyTypeId       Int?   @map("body_type_id")
  /// Só o chapéu usa: o que ele esconde do cabelo. CHECK none, top ou all (migration tamer_appearance)
  hairCut          String @default("none") @map("hair_cut")

  slot        AppearanceSlot         @relation(fields: [appearanceSlotId], references: [id], onDelete: Restrict)
  bodyType    BodyType?              @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  playerParts PlayerAppearancePart[]
  npcParts    NpcAppearancePart[]

  @@index([appearanceSlotId])
  @@index([bodyTypeId])
  @@map("appearance_parts")
  @@schema("ecobeasts")
}

/// As paletas de cor da aparência, da luz à sombra (tamer-appearance/01).
model Palette {
  id        Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration tamer_appearance)
  slug      String @unique
  name      String
  /// CHECK skin, hair ou cloth (migration tamer_appearance)
  kind      String
  /// CHECK ^#[0-9a-f]{6}$ (migration tamer_appearance)
  color1Hex String @map("color1_hex")
  /// CHECK ^#[0-9a-f]{6}$ (migration tamer_appearance)
  color2Hex String @map("color2_hex")
  /// CHECK ^#[0-9a-f]{6}$ (migration tamer_appearance)
  color3Hex String @map("color3_hex")
  /// CHECK ^#[0-9a-f]{6}$ (migration tamer_appearance)
  color4Hex String @map("color4_hex")

  skinPlayers Player[]
  playerParts PlayerAppearancePart[]
  skinNpcs    Npc[]
  npcParts    NpcAppearancePart[]

  @@map("palettes")
  @@schema("ecobeasts")
}

model NpcTamerGreeting {
  id   Int    @id @default(autoincrement())
  /// CHECK 1–120 caracteres (migration npc_tamer_texts)
  text String

  @@map("npc_tamer_greetings")
  @@schema("ecobeasts")
}

model Temperament {
  id              Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug            String @unique
  name            String
  increasedStatId Int    @map("increased_stat_id")
  decreasedStatId Int    @map("decreased_stat_id")

  increasedStat Stat               @relation("TemperamentIncreased", fields: [increasedStatId], references: [id], onDelete: Restrict)
  decreasedStat Stat               @relation("TemperamentDecreased", fields: [decreasedStatId], references: [id], onDelete: Restrict)
  creatures     CreatureInstance[]

  @@index([increasedStatId])
  @@index([decreasedStatId])
  @@map("temperaments")
  @@schema("ecobeasts")
}

model SkillCategory {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  skills Skill[]

  @@map("skill_categories")
  @@schema("ecobeasts")
}

model SkillTarget {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  skills       Skill[]
  skillEffects SkillEffect[]

  @@map("skill_targets")
  @@schema("ecobeasts")
}

model AreaShape {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration board_skill_areas)
  slug String @unique
  name String

  skills Skill[]

  @@map("area_shapes")
  @@schema("ecobeasts")
}

model SkillLearnMethod {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  speciesSkills SpeciesSkill[]

  @@map("skill_learn_methods")
  @@schema("ecobeasts")
}

model StatusCondition {
  id          Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug        String  @unique
  name        String
  isVolatile  Boolean @map("is_volatile")
  description String

  immunities    StatusConditionImmunity[]
  skillEffects  SkillEffect[]
  creatures     CreatureInstance[]
  groundEffects GroundEffect[]

  @@map("status_conditions")
  @@schema("ecobeasts")
}

model GroundEffect {
  id                Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration board_skill_areas)
  slug              String @unique
  name              String
  /// CHECK 1–100, % do HP máximo (migration board_skill_areas)
  damagePercent     Int?   @map("damage_percent")
  /// CHECK 1–100, % do HP máximo curado (migration field_effects)
  healPercent       Int?   @map("heal_percent")
  statusConditionId Int?   @map("status_condition_id")
  /// CHECK ^#[0-9A-Fa-f]{6}$ (migration board_skill_areas)
  colorHex          String @map("color_hex")

  statusCondition StatusCondition?   @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  skills          Skill[]
  stats           GroundEffectStat[]

  @@index([statusConditionId])
  @@map("ground_effects")
  @@schema("ecobeasts")
}

/// O que uma marca muda nos estágios de quem termina a vez nela
/// (.specs/puffcoo-line/01-field-rules.md).
model GroundEffectStat {
  groundEffectId Int @map("ground_effect_id")
  statId         Int @map("stat_id")
  /// CHECK −6–6, sem 0 (migration field_marks)
  stages         Int

  groundEffect GroundEffect @relation(fields: [groundEffectId], references: [id], onDelete: Cascade)
  stat         Stat         @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@id([groundEffectId, statId])
  @@index([statId])
  @@map("ground_effect_stats")
  @@schema("ecobeasts")
}

model StatusConditionImmunity {
  statusConditionId Int @map("status_condition_id")
  elementId         Int @map("element_id")

  statusCondition StatusCondition @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  element         Element         @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@id([statusConditionId, elementId])
  @@index([elementId])
  @@map("status_condition_immunities")
  @@schema("ecobeasts")
}

model EffectType {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  skillEffects SkillEffect[]

  @@map("effect_types")
  @@schema("ecobeasts")
}

model EvolutionTrigger {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug String @unique
  name String

  evolutions Evolution[]

  @@map("evolution_triggers")
  @@schema("ecobeasts")
}

model Species {
  id                   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug                 String @unique
  name                 String
  description          String
  growthRateId         Int    @map("growth_rate_id")
  rarityId             Int    @map("rarity_id")
  /// CHECK ≥ 1 (migration init)
  baseXpYield          Int    @map("base_xp_yield")
  /// CHECK 0–100 (migration capture_rate_0_100)
  captureRate          Int    @map("capture_rate")
  /// CHECK −1–1; −1 = sem gênero (migration init)
  genderRatio          Float  @map("gender_ratio")
  /// CHECK ≥ 0 (migration init)
  heightM              Float  @map("height_m")
  /// CHECK ≥ 0 (migration init)
  weightKg             Float  @map("weight_kg")
  evolvesFromSpeciesId Int?   @map("evolves_from_species_id")

  growthRate     GrowthRate          @relation(fields: [growthRateId], references: [id], onDelete: Restrict)
  rarity         Rarity              @relation(fields: [rarityId], references: [id], onDelete: Restrict)
  evolvesFrom    Species?            @relation("SpeciesEvolvesFrom", fields: [evolvesFromSpeciesId], references: [id], onDelete: Restrict)
  evolvesTo      Species[]           @relation("SpeciesEvolvesFrom")
  elements       SpeciesElement[]
  stats          SpeciesStat[]
  traits         SpeciesTrait[]
  skills         SpeciesSkill[]
  evolutionsFrom Evolution[]         @relation("EvolutionFrom")
  evolutionsTo   Evolution[]         @relation("EvolutionTo")
  starterOption  StarterOption?
  creatures      CreatureInstance[]
  biomes         SpeciesBiome[]
  biomeZones     SpeciesBiomeZone[]
  dayPhases      SpeciesDayPhase[]
  codexEntries   CodexEntry[]
  islandAreas    IslandAreaSpecies[]

  @@index([growthRateId])
  @@index([rarityId])
  @@index([evolvesFromSpeciesId])
  @@map("species")
  @@schema("ecobeasts")
}

model SpeciesElement {
  speciesId Int @map("species_id")
  /// CHECK IN (1, 2) (migration init)
  slot      Int
  elementId Int @map("element_id")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  element Element @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([elementId])
  @@map("species_elements")
  @@schema("ecobeasts")
}

model SpeciesBiome {
  speciesId Int @map("species_id")
  biomeId   Int @map("biome_id")
  /// CHECK 0–100 (migration biomes)
  rate      Int

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  biome   Biome   @relation(fields: [biomeId], references: [id], onDelete: Restrict)

  @@id([speciesId, biomeId])
  @@index([biomeId])
  @@map("species_biomes")
  @@schema("ecobeasts")
}

/// O multiplicador da taxa do bioma numa zona, em %; sem linha, 100.
model SpeciesBiomeZone {
  speciesId   Int @map("species_id")
  biomeZoneId Int @map("biome_zone_id")
  /// CHECK 0–1000 (migration biome_zones)
  ratePercent Int @map("rate_percent")

  species   Species   @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  biomeZone BiomeZone @relation(fields: [biomeZoneId], references: [id], onDelete: Restrict)

  @@id([speciesId, biomeZoneId])
  @@index([biomeZoneId])
  @@map("species_biome_zones")
  @@schema("ecobeasts")
}

/// As partes do dia em que o Ecobeast nasce como selvagem; sem linha, ele não nasce nela.
model SpeciesDayPhase {
  speciesId  Int @map("species_id")
  dayPhaseId Int @map("day_phase_id")

  species  Species  @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  dayPhase DayPhase @relation(fields: [dayPhaseId], references: [id], onDelete: Restrict)

  @@id([speciesId, dayPhaseId])
  @@index([dayPhaseId])
  @@map("species_day_phases")
  @@schema("ecobeasts")
}

model SpeciesStat {
  speciesId     Int @map("species_id")
  statId        Int @map("stat_id")
  /// CHECK 1–255 (migration init)
  baseValue     Int @map("base_value")
  /// CHECK 0–3 (migration init)
  trainingYield Int @map("training_yield")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  stat    Stat    @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@id([speciesId, statId])
  @@index([statId])
  @@map("species_stats")
  @@schema("ecobeasts")
}

model Trait {
  id          Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug        String @unique
  name        String
  description String

  species   SpeciesTrait[]
  creatures CreatureInstance[]

  @@map("traits")
  @@schema("ecobeasts")
}

model SpeciesTrait {
  speciesId Int     @map("species_id")
  traitId   Int     @map("trait_id")
  /// CHECK IN (1, 2, 3) (migration init)
  slot      Int
  isHidden  Boolean @map("is_hidden")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  trait   Trait   @relation(fields: [traitId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([traitId])
  @@map("species_traits")
  @@schema("ecobeasts")
}

model Evolution {
  id                 Int     @id @default(autoincrement())
  speciesId          Int     @map("species_id")
  evolvedSpeciesId   Int     @map("evolved_species_id")
  evolutionTriggerId Int     @map("evolution_trigger_id")
  /// CHECK 1–100 (migration init)
  minLevel           Int?    @map("min_level")
  /// FK futura: items. CHECK IS NULL até a tabela existir (migration init)
  itemId             Int?    @map("item_id")
  /// CHECK 0–255 (migration init)
  minBond            Int?    @map("min_bond")
  /// CHECK IN ('day', 'night') (migration init)
  timeOfDay          String? @map("time_of_day")
  /// FK futura: zones. CHECK IS NULL até a tabela existir (migration init)
  zoneId             Int?    @map("zone_id")

  species          Species          @relation("EvolutionFrom", fields: [speciesId], references: [id], onDelete: Restrict)
  evolvedSpecies   Species          @relation("EvolutionTo", fields: [evolvedSpeciesId], references: [id], onDelete: Restrict)
  evolutionTrigger EvolutionTrigger @relation(fields: [evolutionTriggerId], references: [id], onDelete: Restrict)

  @@index([speciesId])
  @@index([evolvedSpeciesId])
  @@index([evolutionTriggerId])
  @@map("evolutions")
  @@schema("ecobeasts")
}

model StarterOption {
  speciesId Int @id @map("species_id")
  sortOrder Int @unique @map("sort_order")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@map("starter_options")
  @@schema("ecobeasts")
}

model Skill {
  id              Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration init)
  slug            String  @unique
  name            String
  description     String
  elementId       Int     @map("element_id")
  skillCategoryId Int     @map("skill_category_id")
  /// CHECK 0–250 (migration init)
  power           Int
  /// CHECK 0–100 (migration init)
  accuracy        Int
  /// CHECK 5–40 (migration init)
  maxPp           Int     @map("max_pp")
  /// CHECK −7–5 (migration init)
  priority        Int
  /// CHECK 0–3 (migration init)
  critStage       Int     @map("crit_stage")
  skillTargetId   Int     @map("skill_target_id")
  makesContact    Boolean @map("makes_contact")
  /// CHECK 1–10 (migration init)
  minHits         Int     @map("min_hits")
  /// CHECK 1–10 (migration init)
  maxHits         Int     @map("max_hits")
  areaShapeId     Int     @default(1) @map("area_shape_id")
  /// CHECK 1–6 (migration board_skill_areas)
  range           Int     @default(1)
  pierces         Boolean @default(false)
  groundEffectId  Int?    @map("ground_effect_id")
  /// CHECK 1–20, e nulo junto com ground_effect_id (migration board_skill_areas)
  groundTurns     Int?    @map("ground_turns")
  /// CHECK 0–5 (migration skill_cooldown)
  cooldown        Int     @default(0)

  element        Element                 @relation(fields: [elementId], references: [id], onDelete: Restrict)
  skillCategory  SkillCategory           @relation(fields: [skillCategoryId], references: [id], onDelete: Restrict)
  skillTarget    SkillTarget             @relation(fields: [skillTargetId], references: [id], onDelete: Restrict)
  areaShape      AreaShape               @relation(fields: [areaShapeId], references: [id], onDelete: Restrict)
  groundEffect   GroundEffect?           @relation(fields: [groundEffectId], references: [id], onDelete: Restrict)
  effects        SkillEffect[]
  learnedBy      SpeciesSkill[]
  creatureSkills CreatureInstanceSkill[]

  @@index([elementId])
  @@index([skillCategoryId])
  @@index([skillTargetId])
  @@index([areaShapeId])
  @@index([groundEffectId])
  @@map("skills")
  @@schema("ecobeasts")
}

model SkillEffect {
  id                Int  @id @default(autoincrement())
  skillId           Int  @map("skill_id")
  effectTypeId      Int  @map("effect_type_id")
  /// CHECK ≥ 1 (migration init)
  sortOrder         Int  @map("sort_order")
  /// CHECK 1–100 (migration init)
  chance            Int
  skillTargetId     Int? @map("skill_target_id")
  statusConditionId Int? @map("status_condition_id")
  statId            Int? @map("stat_id")
  /// CHECK −6–6 (migration init)
  stages            Int?
  /// CHECK 1–100 (migration init)
  percent           Int?
  /// CHECK ≥ 1 (migration init)
  value             Int?
  /// FK futura: weathers. CHECK IS NULL até a tabela existir (migration init)
  weatherId         Int? @map("weather_id")
  /// CHECK ≥ 1 (migration init)
  minTurns          Int? @map("min_turns")

  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  effectType      EffectType       @relation(fields: [effectTypeId], references: [id], onDelete: Restrict)
  skillTarget     SkillTarget?     @relation(fields: [skillTargetId], references: [id], onDelete: Restrict)
  statusCondition StatusCondition? @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  stat            Stat?            @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@unique([skillId, sortOrder])
  @@index([effectTypeId])
  @@index([skillTargetId])
  @@index([statusConditionId])
  @@index([statId])
  @@map("skill_effects")
  @@schema("ecobeasts")
}

model SpeciesSkill {
  speciesId          Int  @map("species_id")
  skillId            Int  @map("skill_id")
  skillLearnMethodId Int  @map("skill_learn_method_id")
  /// CHECK 0–100 (migration init)
  level              Int?

  species          Species          @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  skillLearnMethod SkillLearnMethod @relation(fields: [skillLearnMethodId], references: [id], onDelete: Restrict)

  @@id([speciesId, skillId, skillLearnMethodId])
  @@index([skillId])
  @@index([skillLearnMethodId])
  @@map("species_skills")
  @@schema("ecobeasts")
}

model ItemCategory {
  id        Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration items)
  slug      String @unique
  name      String
  sortOrder Int    @unique @map("sort_order")

  items Item[]

  @@map("item_categories")
  @@schema("ecobeasts")
}

model Item {
  id             Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration items)
  slug           String  @unique
  name           String
  description    String
  itemCategoryId Int     @map("item_category_id")
  /// CHECK ≥ 1 (migration items)
  price          Int
  sortOrder      Int     @unique @map("sort_order")
  /// CHECK > 0 (migration items)
  captureBonus   Float?  @map("capture_bonus")
  /// CHECK ≥ 1 (migration items)
  healAmount     Int?    @map("heal_amount")
  curesStatus    Boolean @default(false) @map("cures_status")

  itemCategory ItemCategory    @relation(fields: [itemCategoryId], references: [id], onDelete: Restrict)
  inventory    InventoryItem[]
  tamerLevels  TamerLevel[]

  @@index([itemCategoryId])
  @@map("items")
  @@schema("ecobeasts")
}

/// O XP somado para chegar a cada nível do Domador e a recompensa dele (tamer-level/01).
model TamerLevel {
  /// CHECK ≥ 1 (migration tamer_level)
  level              Int  @id
  /// CHECK ≥ 0 (migration tamer_level)
  xpTotal            Int  @map("xp_total")
  /// CHECK ≥ 0 (migration tamer_level)
  rewardCoins        Int  @default(0) @map("reward_coins")
  /// CHECK nulo junto com reward_item_quantity (migration tamer_level)
  rewardItemId       Int? @map("reward_item_id")
  /// CHECK ≥ 1 (migration tamer_level)
  rewardItemQuantity Int? @map("reward_item_quantity")

  rewardItem Item? @relation(fields: [rewardItemId], references: [id], onDelete: Restrict)

  @@index([rewardItemId])
  @@map("tamer_levels")
  @@schema("ecobeasts")
}

/// Quanto XP de Domador cada fonte dá (tamer-level/01).
model TamerXpSource {
  id     Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration tamer_level)
  slug   String @unique
  name   String
  /// CHECK ≥ 0 (migration tamer_level)
  amount Int

  @@map("tamer_xp_sources")
  @@schema("ecobeasts")
}

enum Gender {
  male
  female
  none

  @@map("gender")
  @@schema("ecobeasts")
}

enum CreatureLocation {
  party
  storage

  @@map("creature_location")
  @@schema("ecobeasts")
}

model Player {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  /// CHECK 1–100 (migration init)
  level         Int       @default(1)
  /// CHECK ≥ 0 (migration init)
  coins         Int       @default(0)
  /// O XP total do Domador (tamer-level/01).
  /// CHECK ≥ 0 (migration tamer_level)
  xp            Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  bodyTypeId    Int       @default(1) @map("body_type_id")
  skinPaletteId Int       @default(1) @map("skin_palette_id")
  /// O último sinal de cada minuto (player-stats/02).
  lastPingAt    DateTime? @map("last_ping_at") @db.Timestamptz(3)
  /// O último dia de jogo, na hora de Brasília (player-stats/02).
  lastPlayDay   DateTime? @map("last_play_day") @db.Date

  bodyType        BodyType               @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  skinPalette     Palette                @relation(fields: [skinPaletteId], references: [id], onDelete: Restrict)
  creatures       CreatureInstance[]
  inventory       InventoryItem[]
  codex           CodexEntry[]
  appearanceParts PlayerAppearancePart[]
  discoveries     IslandDiscovery[]
  storyMarks      PlayerStoryMark[]
  counters        PlayerCounter[]

  @@index([bodyTypeId])
  @@index([skinPaletteId])
  @@map("players")
  @@schema("ecobeasts")
}

/// Uma peça vestida pelo Domador (tamer-appearance/01). O lugar se repete
/// aqui para a chave garantir uma peça por lugar.
/// Uma peça vestida por um NPC pessoa (liora-intro/02), com as regras da do Domador.
model NpcAppearancePart {
  npcId            Int  @map("npc_id")
  appearanceSlotId Int  @map("appearance_slot_id")
  appearancePartId Int  @map("appearance_part_id")
  paletteId        Int? @map("palette_id")

  npc     Npc            @relation(fields: [npcId], references: [id], onDelete: Cascade)
  slot    AppearanceSlot @relation(fields: [appearanceSlotId], references: [id], onDelete: Restrict)
  part    AppearancePart @relation(fields: [appearancePartId], references: [id], onDelete: Restrict)
  palette Palette?       @relation(fields: [paletteId], references: [id], onDelete: Restrict)

  @@id([npcId, appearanceSlotId])
  @@index([appearanceSlotId])
  @@index([appearancePartId])
  @@index([paletteId])
  @@map("npc_appearance_parts")
  @@schema("ecobeasts")
}

model PlayerAppearancePart {
  playerId         String @map("player_id") @db.Uuid
  appearanceSlotId Int    @map("appearance_slot_id")
  appearancePartId Int    @map("appearance_part_id")
  paletteId        Int?   @map("palette_id")

  player  Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slot    AppearanceSlot @relation(fields: [appearanceSlotId], references: [id], onDelete: Restrict)
  part    AppearancePart @relation(fields: [appearancePartId], references: [id], onDelete: Restrict)
  palette Palette?       @relation(fields: [paletteId], references: [id], onDelete: Restrict)

  @@id([playerId, appearanceSlotId])
  @@index([appearanceSlotId])
  @@index([appearancePartId])
  @@index([paletteId])
  @@map("player_appearance_parts")
  @@schema("ecobeasts")
}

/// Um contador de um Domador; subject_id é 0 sem recorte (player-stats/01).
model PlayerCounter {
  playerId  String @map("player_id") @db.Uuid
  counterId Int    @map("counter_id")
  subjectId Int    @default(0) @map("subject_id")
  /// CHECK ≥ 0 (migration counters)
  value     Int    @default(0)

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  counter Counter @relation(fields: [counterId], references: [id], onDelete: Restrict)

  @@id([playerId, counterId, subjectId])
  @@index([counterId, subjectId, value(sort: Desc)], map: "player_counters_ranking_idx")
  @@map("player_counters")
  @@schema("ecobeasts")
}

model CreatureInstance {
  uid               String           @id @default(uuid()) @db.Uuid
  playerId          String           @map("player_id") @db.Uuid
  speciesId         Int              @map("species_id")
  nickname          String?
  /// CHECK 1–100 (migration init)
  level             Int
  /// CHECK ≥ 0 (migration init)
  currentXp         Int              @map("current_xp")
  /// CHECK ≥ 0 (migration init)
  currentHp         Int              @map("current_hp")
  temperamentId     Int              @map("temperament_id")
  traitId           Int              @map("trait_id")
  gender            Gender
  isPrismatic       Boolean          @default(false) @map("is_prismatic")
  /// CHECK 0–255 (migration init)
  bond              Int
  /// FK futura: items. CHECK IS NULL até a tabela existir (migration init)
  heldItemId        Int?             @map("held_item_id")
  statusConditionId Int?             @map("status_condition_id")
  /// CHECK party ⇔ party_slot preenchido (migration init)
  location          CreatureLocation
  /// CHECK 1–6 (migration init)
  partySlot         Int?             @map("party_slot")
  /// Domador original; sem relação, porque ele pode não existir mais.
  originalPlayerId  String           @map("original_player_id") @db.Uuid
  caughtAt          DateTime         @map("caught_at") @db.Timestamptz(3)
  /// FK futura: zones. CHECK IS NULL até a tabela existir (migration init)
  caughtZoneId      Int?             @map("caught_zone_id")
  /// As lutas em que ele lutou (player-stats/01). CHECK ≥ 0 (migration counters)
  battles           Int              @default(0)

  player          Player                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  species         Species                 @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  temperament     Temperament             @relation(fields: [temperamentId], references: [id], onDelete: Restrict)
  trait           Trait                   @relation(fields: [traitId], references: [id], onDelete: Restrict)
  statusCondition StatusCondition?        @relation(fields: [statusConditionId], references: [id], onDelete: Restrict)
  stats           CreatureInstanceStat[]
  skills          CreatureInstanceSkill[]

  @@unique([playerId, partySlot])
  @@index([speciesId])
  @@index([temperamentId])
  @@index([traitId])
  @@index([statusConditionId])
  @@map("creature_instances")
  @@schema("ecobeasts")
}

model CreatureInstanceStat {
  creatureUid    String @map("creature_uid") @db.Uuid
  statId         Int    @map("stat_id")
  /// CHECK 0–31 (migration init)
  genes          Int
  /// CHECK 0–252 (migration init)
  trainingPoints Int    @map("training_points")

  creature CreatureInstance @relation(fields: [creatureUid], references: [uid], onDelete: Cascade)
  stat     Stat             @relation(fields: [statId], references: [id], onDelete: Restrict)

  @@id([creatureUid, statId])
  @@index([statId])
  @@map("creature_instance_stats")
  @@schema("ecobeasts")
}

model CreatureInstanceSkill {
  creatureUid String @map("creature_uid") @db.Uuid
  /// CHECK 1–3 (migration skill_cooldown)
  slot        Int
  skillId     Int    @map("skill_id")
  /// CHECK ≥ 0 (migration init)
  currentPp   Int    @map("current_pp")

  creature CreatureInstance @relation(fields: [creatureUid], references: [uid], onDelete: Cascade)
  skill    Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([creatureUid, slot])
  @@index([skillId])
  @@map("creature_instance_skills")
  @@schema("ecobeasts")
}

model InventoryItem {
  playerId String @map("player_id") @db.Uuid
  itemId   Int    @map("item_id")
  /// CHECK ≥ 1 (migration init)
  quantity Int

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([playerId, itemId])
  @@index([itemId])
  @@map("inventory_items")
  @@schema("ecobeasts")
}

model CodexEntry {
  playerId  String    @map("player_id") @db.Uuid
  speciesId Int       @map("species_id")
  seenAt    DateTime  @map("seen_at") @db.Timestamptz(3)
  /// Nulo enquanto só foi visto. CHECK ≥ seen_at (migration codex_entries)
  caughtAt  DateTime? @map("caught_at") @db.Timestamptz(3)

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@id([playerId, speciesId])
  @@index([speciesId])
  @@map("codex_entries")
  @@schema("ecobeasts")
}

model Island {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  /// A casa do jogador. Só uma: índice único parcial islands_one_home (migration home_island)
  isHome      Boolean   @default(false) @map("is_home")

  maps        IslandMap[]
  discoveries IslandDiscovery[]

  @@map("islands")
  @@schema("ecobeasts")
}

/// Um hexágono de ilha que o Domador já descobriu (fog-of-war/01). Sem FK
/// para island_tiles: o hexágono pode sumir numa versão nova da ilha.
model IslandDiscovery {
  playerId     String   @map("player_id") @db.Uuid
  islandId     Int      @map("island_id")
  q            Int
  r            Int
  discoveredAt DateTime @default(now()) @map("discovered_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  island Island @relation(fields: [islandId], references: [id], onDelete: Cascade)

  @@id([playerId, islandId, q, r])
  @@index([islandId])
  @@map("island_discoveries")
  @@schema("ecobeasts")
}

model IslandMap {
  id          Int      @id @default(autoincrement())
  islandId    Int      @map("island_id")
  /// CHECK draft ou published (migration islands)
  kind        String
  /// CHECK 1–40 caracteres (migration islands)
  name        String
  startQ      Int      @map("start_q")
  startR      Int      @map("start_r")
  contentHash String   @map("content_hash")
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  island      Island             @relation(fields: [islandId], references: [id], onDelete: Cascade)
  tiles       IslandTile[]
  actions     IslandAction[]
  actionTiles IslandActionTile[]
  areas       IslandArea[]
  props       IslandProp[]
  trails      IslandTrail[]
  walls       IslandWall[]
  bridges     IslandBridge[]
  npcs        IslandNpc[]

  @@unique([islandId, kind])
  @@map("island_maps")
  @@schema("ecobeasts")
}

model IslandTile {
  islandMapId  Int     @map("island_map_id")
  q            Int
  r            Int
  /// Um dos 7 biomas; a variante de 1 a 3 em hill e mountain é conferida pela rota.
  biomeId      Int     @map("biome_id")
  /// CHECK 0–10 (migration terrain_height_ten)
  height       Int
  /// CHECK 1–6 (migration terrain_height)
  variant      Int
  areaId       Int?    @map("area_id")
  groundTypeId Int?    @map("ground_type_id")
  /// Sem as decorações naturais sorteadas do bioma (free-props/05).
  bare         Boolean @default(false)
  /// A zona do hexágono; nulo é a Comum do bioma (biome-zones/03).
  biomeZoneId  Int?    @map("biome_zone_id")

  islandMap  IslandMap   @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  biomeZone  BiomeZone?  @relation(fields: [biomeZoneId], references: [id], onDelete: SetNull)
  biome      Biome       @relation(fields: [biomeId], references: [id], onDelete: Restrict)
  area       IslandArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  groundType GroundType? @relation(fields: [groundTypeId], references: [id], onDelete: Restrict)

  @@id([islandMapId, q, r])
  @@index([biomeId])
  @@index([areaId])
  @@index([groundTypeId])
  @@index([biomeZoneId])
  @@map("island_tiles")
  @@schema("ecobeasts")
}

model IslandAction {
  id           Int @id @default(autoincrement())
  islandMapId  Int @map("island_map_id")
  actionTypeId Int @map("action_type_id")

  islandMap  IslandMap          @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  actionType ActionType         @relation(fields: [actionTypeId], references: [id], onDelete: Restrict)
  tiles      IslandActionTile[]

  @@index([islandMapId])
  @@index([actionTypeId])
  @@map("island_actions")
  @@schema("ecobeasts")
}

/// Um hexágono de uma ação; duas ações nunca dividem um hexágono.
model IslandActionTile {
  actionId    Int @map("action_id")
  islandMapId Int @map("island_map_id")
  q           Int
  r           Int

  action    IslandAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  islandMap IslandMap    @relation(fields: [islandMapId], references: [id], onDelete: Cascade)

  @@id([actionId, q, r])
  @@unique([islandMapId, q, r])
  @@map("island_action_tiles")
  @@schema("ecobeasts")
}

/// Uma peça solta (.specs/free-props): bloqueia pelas linhas e pode ter uma ação (.specs/free-objects).
model IslandProp {
  id           Int     @id @default(autoincrement())
  islandMapId  Int     @map("island_map_id")
  propTypeId   Int     @map("prop_type_id")
  /// O hexágono do pé.
  q            Int
  r            Int
  /// O pé, em pixels da arte, a partir do centro plano do hexágono.
  dx           Int
  dy           Int
  /// CHECK >= 1 (migration free_props)
  variant      Int
  mirrored     Boolean
  /// Usa as próprias linhas de bloqueio (blocks), e não as do tipo.
  customBlock  Boolean @default(false) @map("custom_block")
  /// Acontece quando o Domador encosta no bloqueio da peça (free-objects/03).
  actionTypeId Int?    @map("action_type_id")
  /// A casa fica sem a fumaça da chaminé (chimney-smoke/01).
  noSmoke      Boolean @default(false) @map("no_smoke")
  /// A sala que a peça abre, no lugar da tela da ação (interiors/01).
  interiorId   Int?    @map("interior_id")
  /// Vazio é sem fala; cada parágrafo é uma fala (prop-dialogue/01). CHECK até 2.000 caracteres (migration prop_dialogue)
  dialogue     String  @default("")

  islandMap  IslandMap         @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  propType   PropType          @relation(fields: [propTypeId], references: [id], onDelete: Restrict)
  blocks     IslandPropBlock[]
  actionType ActionType?       @relation(fields: [actionTypeId], references: [id], onDelete: Restrict)
  interior   Interior?         @relation(fields: [interiorId], references: [id], onDelete: Restrict)

  @@index([islandMapId])
  @@index([propTypeId])
  @@index([actionTypeId])
  @@index([interiorId])
  @@map("island_props")
  @@schema("ecobeasts")
}

/// Uma linha de bloqueio de uma peça ajustada (.specs/free-objects).
model IslandPropBlock {
  id           Int     @id @default(autoincrement())
  islandPropId Int     @map("island_prop_id")
  position     Int
  closed       Boolean
  /// Como PropTypeBlock.points. CHECK tamanho par, de 4 a 128 (migration prop_blocks)
  points       Int[]

  islandProp IslandProp @relation(fields: [islandPropId], references: [id], onDelete: Cascade)

  @@unique([islandPropId, position])
  @@map("island_prop_blocks")
  @@schema("ecobeasts")
}

model IslandArea {
  id          Int    @id @default(autoincrement())
  islandMapId Int    @map("island_map_id")
  /// CHECK 1–40 caracteres (migration islands)
  name        String
  /// Só para o editor. CHECK ^#[0-9A-Fa-f]{6}$ (migration islands)
  colorHex    String @map("color_hex")
  /// Quantos Ecobeasts nascem nela a cada entrada. CHECK 1–200 (migration island_area_spawn_count)
  spawnCount  Int    @default(10) @map("spawn_count")

  islandMap IslandMap           @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  species   IslandAreaSpecies[]
  tiles     IslandTile[]

  @@index([islandMapId])
  @@map("island_areas")
  @@schema("ecobeasts")
}

model IslandAreaSpecies {
  areaId    Int @map("area_id")
  speciesId Int @map("species_id")
  /// CHECK > 0 (migration islands)
  weight    Int
  /// CHECK 1–100 e ≤ max_level (migration islands)
  minLevel  Int @map("min_level")
  /// CHECK 1–100 (migration islands)
  maxLevel  Int @map("max_level")

  area    IslandArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  species Species    @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@id([areaId, speciesId])
  @@index([speciesId])
  @@map("island_area_species")
  @@schema("ecobeasts")
}

enum LoginStatus {
  pending
  complete
  failed

  @@map("login_status")
  @@schema("ecobeasts")
}

model AuthLoginSession {
  id             String      @id @default(uuid()) @db.Uuid
  pollSecretHash String      @map("poll_secret_hash")
  codeVerifier   String      @map("code_verifier")
  status         LoginStatus @default(pending)
  opened         Boolean     @default(false)
  accessToken    String?     @map("access_token")
  refreshToken   String?     @map("refresh_token")
  expiresIn      Int?        @map("expires_in")
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_login_sessions")
  @@schema("ecobeasts")
}

/// Um traço de caminho da ilha (free-trails/03): só desenho.
model IslandTrail {
  id           Int   @id @default(autoincrement())
  islandMapId  Int   @map("island_map_id")
  groundTypeId Int   @map("ground_type_id")
  /// A ordem de desenho na ilha, de 0 em diante.
  position     Int
  /// CHECK 8 a 64 (migration free_trails_trails)
  width        Int   @db.SmallInt
  /// x0, y0, x1, y1, … em pixels da arte, a partir do centro plano do hexágono (0, 0).
  /// CHECK tamanho par, de 4 a 512 (migration free_trails_trails)
  points       Int[]

  islandMap  IslandMap  @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  groundType GroundType @relation(fields: [groundTypeId], references: [id], onDelete: Restrict)

  @@unique([islandMapId, position])
  @@index([groundTypeId])
  @@map("island_trails")
  @@schema("ecobeasts")
}

/// Um tipo de parede (free-fences/01): a cerca de madeira, o muro de pedra e a parede invisível.
model WallType {
  id      Int     @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration free_fences_walls)
  slug    String  @unique
  name    String
  /// Desenhada no jogo; a invisível só bloqueia.
  visible Boolean

  walls IslandWall[]

  @@map("wall_types")
  @@schema("ecobeasts")
}

/// Uma parede da ilha (free-fences/01): a linha bloqueia o Domador.
model IslandWall {
  id          Int   @id @default(autoincrement())
  islandMapId Int   @map("island_map_id")
  wallTypeId  Int   @map("wall_type_id")
  /// A ordem na ilha, de 0 em diante.
  position    Int
  /// x0, y0, x1, y1, … em pixels da arte, a partir do centro plano do hexágono (0, 0).
  /// CHECK tamanho par, de 4 a 256 (migration free_fences_walls)
  points      Int[]

  islandMap IslandMap @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  wallType  WallType  @relation(fields: [wallTypeId], references: [id], onDelete: Restrict)

  @@unique([islandMapId, position])
  @@index([wallTypeId])
  @@map("island_walls")
  @@schema("ecobeasts")
}

/// Um estilo de ponte (bridges/01), recortado do pacote de pontes da craftpix.net.
model BridgeType {
  id   Int    @id @default(autoincrement())
  /// CHECK ^[a-z0-9_]+$ (migration bridges)
  slug String @unique
  name String

  bridges IslandBridge[]

  @@map("bridge_types")
  @@schema("ecobeasts")
}

/// Uma ponte da ilha (bridges/01): um trecho reto, de terra a terra.
model IslandBridge {
  id           Int   @id @default(autoincrement())
  islandMapId  Int   @map("island_map_id")
  bridgeTypeId Int   @map("bridge_type_id")
  /// A ordem na ilha, de 0 em diante.
  position     Int
  /// x0, y0, x1, y1: as duas pontas, em pixels da arte, a partir do centro plano do hexágono (0, 0).
  /// CHECK exatamente 4 números (migration bridges)
  points       Int[]
  /// A largura do piso, em pixels da arte. CHECK 16–64 (migration bridge_width)
  width        Int   @default(28)

  islandMap  IslandMap  @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  bridgeType BridgeType @relation(fields: [bridgeTypeId], references: [id], onDelete: Restrict)

  @@unique([islandMapId, position])
  @@index([bridgeTypeId])
  @@map("island_bridges")
  @@schema("ecobeasts")
}

/// Um NPC posto numa versão de ilha (.specs/island-npcs).
model IslandNpc {
  id           Int     @id @default(autoincrement())
  islandMapId  Int     @map("island_map_id")
  npcId        Int     @map("npc_id")
  /// O hexágono onde ele nasce, que sempre faz parte do passeio.
  q            Int
  r            Int
  /// Parado; com true, o passeio é ignorado.
  still        Boolean
  /// Vazio é sem diálogo. CHECK até 2.000 caracteres (migration island_npcs)
  dialogue     String
  /// Nulo é sem ação.
  actionTypeId Int?    @map("action_type_id")

  islandMap  IslandMap       @relation(fields: [islandMapId], references: [id], onDelete: Cascade)
  npc        Npc             @relation(fields: [npcId], references: [id], onDelete: Restrict)
  actionType ActionType?     @relation(fields: [actionTypeId], references: [id], onDelete: Restrict)
  tiles      IslandNpcTile[]

  @@index([islandMapId])
  @@index([npcId])
  @@index([actionTypeId])
  @@map("island_npcs")
  @@schema("ecobeasts")
}

/// Um hexágono do passeio de um NPC, fora o de nascimento.
model IslandNpcTile {
  islandNpcId Int @map("island_npc_id")
  q           Int
  r           Int

  islandNpc IslandNpc @relation(fields: [islandNpcId], references: [id], onDelete: Cascade)

  @@id([islandNpcId, q, r])
  @@map("island_npc_tiles")
  @@schema("ecobeasts")
}

/// Um Marco da história que o Domador ligou (story/01). O servidor guarda o
/// texto sem saber o que ele significa; o roteiro mora no cliente.
model PlayerStoryMark {
  playerId  String   @map("player_id") @db.Uuid
  /// CHECK ^[a-z0-9_]{1,48}$ (migration story_marks)
  mark      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, mark])
  @@map("player_story_marks")
  @@schema("ecobeasts")
}

/// O lado de dentro de um prédio, uma sala de quadrados de 16 px (interiors/01).
model Interior {
  id        Int      @id @default(autoincrement())
  /// CHECK de 1 a 40 caracteres (migration interiors)
  name      String
  /// CHECK de 4 a 64 (migration interiors)
  width     Int      @db.SmallInt
  /// CHECK de 4 a 64 (migration interiors)
  height    Int      @db.SmallInt
  /// O quadrado onde o Domador nasce e por onde sai. CHECK dentro da sala (migration interiors)
  doorX     Int      @map("door_x") @db.SmallInt
  doorY     Int      @map("door_y") @db.SmallInt
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  tiles   InteriorTile[]
  objects InteriorObject[]
  blocks  InteriorBlock[]
  npcs    InteriorNpc[]
  props   IslandProp[]

  @@map("interiors")
  @@schema("ecobeasts")
}

/// Um tile de uma camada da sala.
model InteriorTile {
  interiorId Int    @map("interior_id")
  /// CHECK floor, floor_detail, wall ou wall_detail (migration interiors)
  layer      String
  /// CHECK >= 0 (migration interiors)
  x          Int    @db.SmallInt
  y          Int    @db.SmallInt
  /// A folha do pacote. CHECK ^[a-z0-9_]+$ (migration interiors)
  sheet      String
  /// CHECK de 0 a 63 (migration interiors)
  col        Int    @db.SmallInt
  /// CHECK de 0 a 63 (migration interiors)
  row        Int    @db.SmallInt

  interior Interior @relation(fields: [interiorId], references: [id], onDelete: Cascade)

  @@id([interiorId, layer, x, y])
  @@map("interior_tiles")
  @@schema("ecobeasts")
}

/// Um retângulo de tiles de uma folha, posto inteiro, ordenado pelo pé.
model InteriorObject {
  id         Int    @id @default(autoincrement())
  interiorId Int    @map("interior_id")
  /// O quadrado do canto de cima à esquerda. CHECK >= 0 (migration interiors)
  x          Int    @db.SmallInt
  y          Int    @db.SmallInt
  /// CHECK ^[a-z0-9_]+$ (migration interiors)
  sheet      String
  /// O tile do canto de cima à esquerda na folha. CHECK de 0 a 63 (migration interiors)
  col        Int    @db.SmallInt
  row        Int    @db.SmallInt
  /// CHECK de 1 a 8 tiles (migration interiors)
  width      Int    @db.SmallInt
  height     Int    @db.SmallInt

  interior Interior @relation(fields: [interiorId], references: [id], onDelete: Cascade)

  @@index([interiorId])
  @@map("interior_objects")
  @@schema("ecobeasts")
}

/// Um quadrado bloqueado: da parede sólida, da linha de baixo de um objeto ou à mão.
model InteriorBlock {
  interiorId Int @map("interior_id")
  /// CHECK >= 0 (migration interiors)
  x          Int @db.SmallInt
  y          Int @db.SmallInt

  interior Interior @relation(fields: [interiorId], references: [id], onDelete: Cascade)

  @@id([interiorId, x, y])
  @@map("interior_blocks")
  @@schema("ecobeasts")
}

/// Um NPC parado num quadrado da sala.
model InteriorNpc {
  id           Int    @id @default(autoincrement())
  interiorId   Int    @map("interior_id")
  npcId        Int    @map("npc_id")
  /// CHECK >= 0 (migration interiors)
  x            Int    @db.SmallInt
  y            Int    @db.SmallInt
  /// Vazio é sem fala. CHECK até 2.000 caracteres (migration interiors)
  dialogue     String
  /// Nulo é sem ação.
  actionTypeId Int?   @map("action_type_id")

  interior   Interior    @relation(fields: [interiorId], references: [id], onDelete: Cascade)
  npc        Npc         @relation(fields: [npcId], references: [id], onDelete: Restrict)
  actionType ActionType? @relation(fields: [actionTypeId], references: [id], onDelete: Restrict)

  @@index([interiorId])
  @@index([npcId])
  @@index([actionTypeId])
  @@map("interior_npcs")
  @@schema("ecobeasts")
}
