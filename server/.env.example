# Copie para .env e preencha com os valores do seu projeto Supabase.
# NUNCA coloque valores reais neste arquivo: ele vai para o git.
#
# Onde achar: painel do Supabase > botão "Connect" > aba "ORMs" > Prisma.
# Troque [YOUR-PASSWORD] pela senha do banco (Settings > Database).

# Pooler (Supavisor): usada pelo servidor.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexão direta (ou o pooler em modo sessão, porta 5432): usada pelas migrations.
DIRECT_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Porta do servidor (padrão 3100; a 3000 costuma estar ocupada por outros projetos).
PORT=3100

# Chamadas permitidas por IP a cada 60 segundos (padrão 100).
THROTTLE_LIMIT=100

# ─── Login com Google (Supabase Auth) ───
# Endereço do projeto: painel do Supabase > Project Settings > Data API > Project URL.
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública do projeto: Project Settings > API Keys > Publishable key.
# (A chave secreta / service_role NÃO é usada.)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Endereço deste servidor visto pelo navegador (padrão http://localhost:<PORT>).
# Para testar o login no celular, use o IP do PC na rede, como http://192.168.0.10:3100.
PUBLIC_BASE_URL=http://localhost:3100
