[gd_scene format=3]

[ext_resource type="Script" path="res://screens/board_battle/next_creature_row.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/creature_portrait.tscn" id="2_portrait"]
[ext_resource type="PackedScene" path="res://ui/components/hp_bar.tscn" id="3_hp_bar"]

[node name="NextCreatureRow" type="Button"]
custom_minimum_size = Vector2(0, 112)
layout_mode = 2
theme_type_variation = &"OutlineButton"
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 16

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="Portrait" parent="Margin/Row" instance=ExtResource("2_portrait")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
portrait_size = 88

[node name="Info" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Row/Info"]
layout_mode = 2
mouse_filter = 2

[node name="NameLabel" type="Label" parent="Margin/Row/Info/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 24
clip_text = true

[node name="LevelLabel" type="Label" parent="Margin/Row/Info/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20

[node name="HpBar" parent="Margin/Row/Info" instance=ExtResource("3_hp_bar")]
unique_name_in_owner = true
layout_mode = 2
show_numbers = true
