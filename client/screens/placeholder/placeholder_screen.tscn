[gd_scene format=3]

[ext_resource type="Script" path="res://screens/placeholder/placeholder_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/safe_area.tscn" id="2_safe_area"]

[node name="PlaceholderScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
