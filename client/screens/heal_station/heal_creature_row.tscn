[gd_scene format=3]

[ext_resource type="Script" path="res://screens/heal_station/heal_creature_row.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/creature_portrait.tscn" id="2_portrait"]
[ext_resource type="PackedScene" path="res://ui/components/hp_bar.tscn" id="3_hp_bar"]

[node name="HealCreatureRow" type="PanelContainer"]
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"SectionPanel"
script = ExtResource("1_script")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="Portrait" parent="Row" instance=ExtResource("2_portrait")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
portrait_size = 88

[node name="Info" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Row/Info"]
layout_mode = 2
mouse_filter = 2

[node name="NameLabel" type="Label" parent="Row/Info/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 24
clip_text = true

[node name="LevelLabel" type="Label" parent="Row/Info/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20

[node name="HpBar" parent="Row/Info" instance=ExtResource("3_hp_bar")]
unique_name_in_owner = true
layout_mode = 2
show_numbers = true

[node name="DetailLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20
clip_text = true
