[gd_scene format=3]

[ext_resource type="Script" path="res://screens/hub/profile_debug_panel.gd" id="1_script"]

[node name="ProfileDebugPanel" type="VBoxContainer"]
theme_override_constants/separation = 16
script = ExtResource("1_script")

[node name="NameLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
