[gd_scene format=3]

[ext_resource type="Script" path="res://screens/creature_details/skill_row.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/element_badge.tscn" id="2_badge"]

[node name="SkillRow" type="PanelContainer"]
size_flags_vertical = 3
theme_type_variation = &"SectionPanel"
script = ExtResource("1_script")

[node name="Details" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Details"]
layout_mode = 2

[node name="NameLabel" type="Label" parent="Details/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 26

[node name="PpLabel" type="Label" parent="Details/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20

[node name="Info" type="HBoxContainer" parent="Details"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Badge" parent="Details/Info" instance=ExtResource("2_badge")]
unique_name_in_owner = true
layout_mode = 2

[node name="CategoryLabel" type="Label" parent="Details/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20

[node name="PowerLabel" type="Label" parent="Details/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20

[node name="AccuracyLabel" type="Label" parent="Details/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 20

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Vazio"
horizontal_alignment = 1
vertical_alignment = 1
