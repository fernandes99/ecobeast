[gd_scene format=3]

[ext_resource type="Script" path="res://screens/login/login_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/safe_area.tscn" id="2_safe_area"]

[node name="LoginScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="SafeArea" parent="." instance=ExtResource("2_safe_area")]
layout_mode = 1

[node name="Content" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TopSpace" type="Control" parent="SafeArea/Content"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Logo" type="Label" parent="SafeArea/Content"]
layout_mode = 2
theme_type_variation = &"LogoLabel"
theme_override_font_sizes/font_size = 72
text = "Ecobeast"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="SafeArea/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
text = "Capture, treine e batalhe."
horizontal_alignment = 1

[node name="Gap" type="Control" parent="SafeArea/Content"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
mouse_filter = 2

[node name="ErrorLabel" type="Label" parent="SafeArea/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"DangerLabel"
horizontal_alignment = 1
autowrap_mode = 3

[node name="LoginButton" type="Button" parent="SafeArea/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Entrar com Google"

[node name="WaitingBox" type="VBoxContainer" parent="SafeArea/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 16

[node name="WaitingTitle" type="Label" parent="SafeArea/Content/WaitingBox"]
layout_mode = 2
text = "Continue no navegador…"
horizontal_alignment = 1
autowrap_mode = 3

[node name="WaitingHint" type="Label" parent="SafeArea/Content/WaitingBox"]
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
text = "Depois de entrar, volte para cá."
horizontal_alignment = 1
autowrap_mode = 3

[node name="CancelButton" type="Button" parent="SafeArea/Content/WaitingBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OutlineButton"
text = "Cancelar"

[node name="BottomSpace" type="Control" parent="SafeArea/Content"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 1.5
mouse_filter = 2
