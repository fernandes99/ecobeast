[gd_scene format=3]

[ext_resource type="Script" path="res://screens/bag/bag_item_row.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/item_icon.tscn" id="2_icon"]

[node name="BagItemRow" type="PanelContainer"]
layout_mode = 2
mouse_filter = 1
