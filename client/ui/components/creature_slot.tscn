[node name="LevelRow" type="HBoxContainer" parent="Content/Info/InfoColumn"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="ElementDot" type="Panel" parent="Content/Info/InfoColumn/LevelRow"]
