[gd_scene format=3]

[ext_resource type="Script" path="res://ui/components/creature_slot.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/creature_portrait.tscn" id="2_portrait"]
[ext_resource type="PackedScene" path="res://ui/components/hp_bar.tscn" id="3_hp_bar"]

[node name="CreatureSlot" type="PanelContainer"]
size_flags_horizontal = 3
mouse_filter = 1
mouse_default_cursor_shape = 2
script = ExtResource("1_script")

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="PortraitMargin" type="MarginContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_top = 6
theme_override_constants/margin_bottom = 2

[node name="Portrait" parent="Content/PortraitMargin" instance=ExtResource("2_portrait")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
portrait_size = 84

[node name="Info" type="PanelContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="InfoColumn" type="VBoxContainer" parent="Content/Info"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="NameLabel" type="Label" parent="Content/Info/InfoColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 16
