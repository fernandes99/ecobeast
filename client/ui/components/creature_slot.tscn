[gd_scene format=3]

[ext_resource type="Script" path="res://ui/components/creature_slot.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/creature_portrait.tscn" id="2_portrait"]
[ext_resource type="PackedScene" path="res://ui/components/hp_bar.tscn" id="3_hp_bar"]

[node name="CreatureSlot" type="PanelContainer"]
size_flags_horizontal = 3
mouse_filter = 1
mouse_default_cursor_shape = 2
script = ExtResource("1_script")

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Portrait" parent="Content" instance=ExtResource("2_portrait")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
portrait_size = 96

[node name="NameLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
text_overrun_behavior = 3

[node name="LevelLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1

[node name="HpBar" parent="Content" instance=ExtResource("3_hp_bar")]
unique_name_in_owner = true
layout_mode = 2
show_numbers = true

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
text = "Vazio"
horizontal_alignment = 1
vertical_alignment = 1
