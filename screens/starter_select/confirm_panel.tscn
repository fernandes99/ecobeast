[gd_scene format=3]

[ext_resource type="Script" path="res://screens/starter_select/confirm_panel.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/creature_portrait.tscn" id="2_portrait"]
[ext_resource type="PackedScene" path="res://ui/components/element_badge.tscn" id="3_badge"]

[node name="ConfirmPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Portrait" parent="Center/Panel/Content" instance=ExtResource("2_portrait")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
