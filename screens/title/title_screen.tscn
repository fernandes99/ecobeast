[gd_scene format=3]

[ext_resource type="Script" path="res://screens/title/title_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/safe_area.tscn" id="2_safe_area"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="SafeArea" parent="." instance=ExtResource("2_safe_area")]
layout_mode = 1

[node name="Content" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TopSpace" type="Control" parent="SafeArea/Content"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Logo" type="Label" parent="SafeArea/Content"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0.168627, 0.682353, 0.556863, 1)
theme_override_font_sizes/font_size = 72
text = "Ecobeast"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="SafeArea/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
text = "Capture, treine e batalhe."
horizontal_alignment = 1

[node name="Gap" type="Control" parent="SafeArea/Content"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
mouse_filter = 2

[node name="Prompt" type="Label" parent="SafeArea/Content"]
layout_mode = 2
text = "Como você quer ser chamado, Domador?"
horizontal_alignment = 1
autowrap_mode = 3

[node name="NameEdit" type="LineEdit" parent="SafeArea/Content"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Seu nome"
max_length = 16

[node name="Hint" type="Label" parent="SafeArea/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
theme_override_font_sizes/font_size = 18
text = "De 2 a 16 letras ou números."
horizontal_alignment = 1
autowrap_mode = 3

[node name="StartButton" type="Button" parent="SafeArea/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Começar"

[node name="BottomSpace" type="Control" parent="SafeArea/Content"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 1.5
mouse_filter = 2

[node name="KeyboardSpacer" type="Control" parent="SafeArea/Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
