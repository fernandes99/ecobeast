[gd_scene format=3]

[ext_resource type="Script" path="res://ui/components/element_badge.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="pill"]
resource_local_to_scene = true
content_margin_left = 16.0
content_margin_top = 2.0
content_margin_right = 16.0
content_margin_bottom = 2.0
